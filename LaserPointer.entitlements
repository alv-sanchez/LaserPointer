<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox: the ONLY entitlement this app gets.
         No network, no file access, no camera/mic, no Apple Events.
         The sandbox does not restrict window creation, window level,
         collectionBehavior, Carbon hotkey registration, NSEvent.mouseLocation,
         or UserDefaults (which redirects into the app's own container), so
         nothing this app needs is affected — while reading ~/.ssh, ~/Documents,
         or the network becomes structurally impossible rather than merely
         "not currently coded". -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
